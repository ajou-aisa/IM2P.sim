Subject: Expose the LoopMatmul execute stream through a paired-microtile hook

Route execute commands through ex_hook.out/in before the global arbiter, count the
re-entering stream in ex_utilization, export the execute request and progress, and let
hold keep a loop's execute part open. LoopMatmul.apply connects out to in and ties hold
low, so every unhooked user is unchanged.

diff --git a/src/main/scala/gemmini/LoopMatmul.scala b/src/main/scala/gemmini/LoopMatmul.scala
--- a/src/main/scala/gemmini/LoopMatmul.scala
+++ b/src/main/scala/gemmini/LoopMatmul.scala
@@ -803,6 +803,30 @@
   val ldD = Module(new LoopMatmulLdD(block_size, coreMaxAddrBits, iterator_bitwidth, max_acc_addr, input_w, acc_w, max_block_len, max_block_len_acc, concurrent_loops, mvin_rs2_t))
   val ex = Module(new LoopMatmulExecute(block_size, coreMaxAddrBits, iterator_bitwidth, max_addr, max_acc_addr, concurrent_loops, preload_rs1_t, preload_rs2_t, compute_rs1_t, compute_rs2_t))
   val stC = Module(new LoopMatmulStC(block_size, coreMaxAddrBits, iterator_bitwidth, max_acc_addr, input_w, acc_w, max_block_len, concurrent_loops, mvout_rs2_t))
+
+  // IM2P paired microtile: the execute command stream leaves through ex_hook.out and re-enters
+  // through ex_hook.in before the global arbiter; hold keeps a loop's execute part open while the
+  // hook still owes commands for it. LoopMatmul.apply connects out to in and ties hold low, so the
+  // unhooked unroller is unchanged.
+  val ex_hook = IO(new Bundle {
+    val out = Decoupled(new RoCCCommand)
+    val in = Flipped(Decoupled(new RoCCCommand))
+    val req = Valid(new LoopMatmulExecuteReq(block_size, coreMaxAddrBits, iterator_bitwidth, max_addr, max_acc_addr, concurrent_loops))
+    val i = Output(UInt(iterator_bitwidth.W))
+    val j = Output(UInt(iterator_bitwidth.W))
+    val k = Output(UInt(iterator_bitwidth.W))
+    val idle = Output(Bool())
+    val rob_overloaded = Output(Bool())
+    val hold = Input(Bool())
+  })
+  ex_hook.out <> ex.io.cmd
+  ex_hook.req.valid := ex.io.req.fire
+  ex_hook.req.bits := ex.io.req.bits
+  ex_hook.i := ex.io.i
+  ex_hook.j := ex.io.j
+  ex_hook.k := ex.io.k
+  ex_hook.idle := ex.io.idle
+  ex_hook.rob_overloaded := ex.io.rob_overloaded
 
   // Create command queue
   val cmd = Queue(io.in)
@@ -829,7 +853,7 @@
   // Create global arbiter
   val arb = Module(new Arbiter(new RoCCCommand(), 4))
   arb.io.in(0) <> stC.io.cmd
-  arb.io.in(1) <> ex.io.cmd
+  arb.io.in(1) <> ex_hook.in
   arb.io.in(2) <> ldD.io.cmd
   arb.io.in(3) <> ldab_arb.io.out
   val unrolled_cmd = arb.io.out
@@ -841,7 +865,7 @@
 
   ld_utilization := ld_utilization +& (ldA.io.cmd.fire || ldB.io.cmd.fire || ldD.io.cmd.fire) -& io.ld_completed
   st_utilization := st_utilization +& stC.io.cmd.fire -& io.st_completed
-  ex_utilization := ex_utilization +& ex.io.cmd.fire -& io.ex_completed
+  ex_utilization := ex_utilization +& ex_hook.in.fire -& io.ex_completed
 
   assert(ld_utilization >= io.ld_completed, "ld utilization underflow")
   assert(st_utilization >= io.st_completed, "st utilization underflow")
@@ -1089,7 +1113,7 @@
     loops(ldB.io.loop_id).ldb_completed := true.B
   }
 
-  when (ex.io.idle && loops(ex.io.loop_id).running && loops(ex.io.loop_id).ex_started) {
+  when (ex.io.idle && !ex_hook.hold && loops(ex.io.loop_id).running && loops(ex.io.loop_id).ex_started) {
     loops(ex.io.loop_id).ex_completed := true.B
   }
 
@@ -1131,6 +1155,8 @@
     mod.io.ld_completed := ld_completed
     mod.io.st_completed := st_completed
     mod.io.ex_completed := ex_completed
+    mod.ex_hook.in <> mod.ex_hook.out
+    mod.ex_hook.hold := false.B
     (mod.io.out, mod.io.busy)
   }
 
