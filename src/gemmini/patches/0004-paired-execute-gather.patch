 import org.chipsalliance.cde.config.Parameters
 import midas.targetutils.PerfCounter
 
+// IM2P paired microtile: one sideband entry per command entering the ExecuteController.
+class ExecuteGatherEntry(rowsCount: Int, rowBits: Int) extends Bundle {
+  val gather = Bool() // a PRELOAD whose D rows are read from `rows`
+  val residual = Bool() // the command belongs to a residual microtile (observation only)
+  val rows = Vec(rowsCount, UInt(rowBits.W))
+  val w_base = UInt(rowBits.W)
+}
+
+class ExecuteGatherRead(indexBits: Int, rowBits: Int) extends Bundle {
+  val row = UInt(indexBits.W) // preload row index, block_size - 1 - d_fire_counter
+  val address = UInt(rowBits.W) // full scratchpad address read
+  val relative = UInt(rowBits.W) // address - w_base
+}
+
+class ExecuteMeshRow(indexBits: Int, dataBits: Int) extends Bundle {
+  val row = UInt(indexBits.W)
+  val data = UInt(dataBits.W)
+}
+
